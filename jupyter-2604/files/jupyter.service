[Unit]
Description=Jupyter Notebook

[Service]
Type=simple
EnvironmentFile=-/etc/environment.d/codioenv.conf
ExecStart=/bin/bash -lc '/home/codio/miniconda3/bin/jupyter notebook -y --IdentityProvider.token="" --port 3000 --ServerApp.ip="0.0.0.0" --no-browser --ServerApp.tornado_settings=\'{ "headers": { "Content-Security-Policy": "frame-ancestors \'self\' https://*" } }\''
User=codio
Group=codio
WorkingDirectory=/home/codio/workspace
Restart=always
RestartSec=10
#KillMode=mixed

[Install]
WantedBy=multi-user.target
